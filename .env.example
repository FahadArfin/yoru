# Local development: npm run dev:all → http://127.0.0.1:5183
PORT=5184
DATA_DIR=./data
APP_ORIGIN=http://localhost:5184
TRUST_PROXY=0
COOKIE_SECURE=false

# Register your application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5184/api/auth/discord/callback
DISCORD_INVITE_URL=

# Optional MyAnimeList account connection and manual one-way list sync.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:5184/api/mal/callback
# A random 32-byte encryption key encoded as base64. Keep it outside Git.
MAL_TOKEN_ENCRYPTION_KEY=

# Public build-time configuration. No credentials or secret tokens here.
# Optional provider URL template using {malId}, {episode}, and {language}.
VITE_ANIME_EMBED_TEMPLATE=

# Reproducible offline catalog for tests only. Leave 0 in everyday use.
CATALOG_OFFLINE=0

# Server-only application token from AnimeSchedule.net account settings > API.
ANIMESCHEDULE_API_TOKEN=

# Optional server-only manga reader bridge. Never use a VITE_ prefix for its key.
# Production Sites receives the same key privately; its tunnel URL registers automatically.
READER_BRIDGE_KEY=
# Local Node preview only; omit on Sites to use the registered HTTPS tunnel.
READER_BRIDGE_URL=
