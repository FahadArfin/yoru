{
  "name": "yoru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183",
    "api": "node --env-file-if-exists=.env server/index.js",
    "dev:all": "concurrently -k -n API,WEB \"npm:api\" \"npm:dev\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.3.0",
    "helmet": "^8.1.0",
    "hls.js": "1.6.16",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "vite": "^7.1.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
