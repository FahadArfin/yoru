{
  "name": "yoru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183",
    "api": "node --env-file-if-exists=.env server/index.js",
    "dev:all": "concurrently -k -n API,WEB \"npm:api\" \"npm:dev\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "build:sites": "node scripts/build-sites.mjs",
    "dev:sites": "vite --config vite.sites.config.js",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.sites.jsonc",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:sites": "playwright test --config playwright.sites.config.js",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.3.0",
    "helmet": "^8.1.0",
    "hls.js": "1.7.3",
    "hono": "^4.13.9",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.5",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^5.20260907.0-alpha",
    "prettier": "^3.6.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "qs": "6.16.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.0"
    }
  }
}
